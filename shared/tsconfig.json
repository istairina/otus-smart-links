{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": false,
    "module": "commonjs",
    "target": "es2020",
    "declaration": true,
    "declarationMap": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}

